# LLM configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
MOCK_LLM=false

# Job discovery (comma-separated list)
# Example: JOB_SOURCES=linkedin,indeed,greenhouse
JOB_SOURCES=

# Email scanning (disabled by default)
EMAIL_SCANNING_ENABLED=false
IMAP_SERVER=
IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Cleanup
RECYCLE_BIN_DAYS=7

# Paths
DATA_DIR=data
